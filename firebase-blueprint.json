{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered client or administrator",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "fullName": { "type": "string" },
        "role": { "type": "string", "enum": ["client", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "phoneNumber": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "Plan": {
      "title": "Hosting Plan",
      "description": "Available hosting packages",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "type": { "type": "string", "enum": ["shared", "vps", "game"] },
        "features": { "type": "array", "items": { "type": "string" } },
        "description": { "type": "string" }
      },
      "required": ["id", "name", "price", "type"]
    },
    "Order": {
      "title": "Order",
      "description": "Client order for hosting or domains",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "planId": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "completed", "cancelled"] },
        "paymentMethod": { "type": "string", "enum": ["bkash", "nagad", "card"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "amount", "status"]
    },
    "Ticket": {
      "title": "Support Ticket",
      "description": "Client support request",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "subject": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "closed", "in-progress"] },
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "senderId": { "type": "string" },
              "text": { "type": "string" },
              "timestamp": { "type": "string", "format": "date-time" }
            }
          }
        }
      },
      "required": ["id", "userId", "subject", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile data"
    },
    "/plans/{planId}": {
      "schema": "Plan",
      "description": "Publicly available hosting plans"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Order records linking users to plans"
    },
    "/tickets/{ticketId}": {
      "schema": "Ticket",
      "description": "Support ticket thread"
    }
  }
}
